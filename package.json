{
  "name": "o-isym",
  "version": "5.0.0",
  "description": "O-Isym — sistema personal de organización y planificación",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test",
    "build:win": "node scripts/build-windows.cjs nsis",
    "build:win:portable": "node scripts/build-windows.cjs portable",
    "build:win:dir": "node scripts/build-windows.cjs dir"
  },
  "devDependencies": {
    "electron": "45.3.0",
    "electron-builder": "26.18.0",
    "jsdom": "22.1.0"
  },
  "build": {
    "appId": "com.oisym.app",
    "productName": "O-Isym",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "assets/**/*",
      "index.html",
      "package.json",
      "app.ico"
    ],
    "win": {
      "icon": "app.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signExecutable": false,
      "artifactName": "O-Isym-${version}-Windows-${arch}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "O-Isym",
      "installerIcon": "app.ico",
      "uninstallerIcon": "app.ico",
      "installerHeaderIcon": "app.ico",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false,
      "include": "scripts/installer.nsh",
      "language": "3082"
    },
    "portable": {
      "artifactName": "O-Isym-${version}-Windows-${arch}-Portable.${ext}"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
